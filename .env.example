# Use forward slashes "/" in paths for compatibility across platforms

# Logging
# Logging level. Must be one of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL="DEBUG"


# Dependencies
# Whether to download dependencies.
SHOULD_DOWNLOAD_DEPENDENCIES="False"

# Re-download dependencies even if they are already present.
# Required when SHOULD_DOWNLOAD_DEPENDENCIES is True
FORCE_DOWNLOAD_DEPENDENCIES="False"

# CUE4P-BatchExport release tag to install. If 'latest', the latest stable
# release is used (pre-releases skipped). Set to a specific tag (e.g.
# 'v1.6.2-test.1') to pin a version; roll back by setting this to 'latest' again
# and re-running with dependency download enabled.
# Required when SHOULD_DOWNLOAD_DEPENDENCIES is True
# Example: v1.6.2-test.1
BATCH_EXPORT_RELEASE="latest"


# Steam Download
# Whether to download Steam game files.
SHOULD_DOWNLOAD_STEAM_GAME="False"

# Re-download/update Steam game files even if they are already present.
# Required when SHOULD_DOWNLOAD_STEAM_GAME is True
FORCE_STEAM_DOWNLOAD="False"

# Steam manifest ID to download. If 'latest', the latest manifest ID will be used.
# Required when SHOULD_DOWNLOAD_STEAM_GAME is True
MANIFEST_ID="latest"

# Steam username for authentication.
# Required when SHOULD_DOWNLOAD_STEAM_GAME is True
# Example: example_user
STEAM_USERNAME=""

# Steam password for authentication.
# Required when SHOULD_DOWNLOAD_STEAM_GAME is True
# Example: example_password
STEAM_PASSWORD=""

# Path to the local Steam game installation directory.
# Required when SHOULD_DOWNLOAD_STEAM_GAME is True
# Example: C:/WRFrontiersDB/SteamDownload
STEAM_GAME_DOWNLOAD_DIR=""


# Mapping
# Whether to get the mapping file using Dumper7.
SHOULD_GET_MAPPER="False"

# Re-generate the mapping file even if it already exists.
# Required when SHOULD_GET_MAPPER is True
FORCE_GET_MAPPER="False"

# (Windows only) Path to where Dumper7 outputs its generated SDK. Not required
# on Linux — the UE4SS path is used instead.
# Example: C:/Dumper-7
DUMPER7_OUTPUT_DIR=""

# Path to save the generated mapping file (.usmap) at. Should end in .usmap
# Required when SHOULD_GET_MAPPER or SHOULD_BATCH_EXPORT or SHOULD_EXPORT_MAPS is True
# Example: C:/WRFrontiersDB/Mappings/2025-09-30.usmap
OUTPUT_MAPPER_FILE=""


# Batch Export
# Whether to run the BatchExport tool to export assets.
SHOULD_BATCH_EXPORT="False"

# Re-run the BatchExport even if output directory is not empty.
# Required when SHOULD_BATCH_EXPORT is True
FORCE_EXPORT="False"

# Path to save the exported assets to. The map export reads its map list from
# here.
# Required when SHOULD_BATCH_EXPORT or SHOULD_EXPORT_MAPS is True
# Example: C:/WRFrontiersDB/ExportedData
OUTPUT_DATA_DIR=""

# Whether to export textures.
# Required when SHOULD_BATCH_EXPORT is True
SHOULD_EXPORT_TEXTURES="True"


# Map Export
# Whether to export the released maps with BatchExport's map mode (one scene per
# map plus the geometry it refers to). Needs a BatchExport release with the map
# mode (see BATCH_EXPORT_RELEASE). The map list is read from the asset export in
# OUTPUT_DATA_DIR, so the regular BatchExport must have run first.
SHOULD_EXPORT_MAPS="False"

# Re-run the map export even if OUTPUT_MAPS_DIR is not empty.
# Required when SHOULD_EXPORT_MAPS is True
FORCE_EXPORT_MAPS="False"

# Path to save the exported maps to (maps/<Map>/ scenes, assets/, config/).
# Required when SHOULD_EXPORT_MAPS is True
# Example: C:/WRFrontiersDB/Maps/2025-09-30
OUTPUT_MAPS_DIR=""


# Mapping (Linux)
# (Linux only) Path to the Wine prefix directory (WINEPREFIX). Required for the
# mapper step on Linux; unused on Windows. Validated at runtime rather than via
# depends_on so it is not required on Windows.
# Example: /srv/dev/wrf/prefix
WINE_PREFIX=""

# (Linux only) Path to the Proton installation directory (PROTONPATH). Must be
# the WRF-TLS custom build. Required for the mapper step on Linux; unused on
# Windows. Validated at runtime rather than via depends_on so it is not required
# on Windows.
# Example: /srv/dev/wrf/proton/GE-Proton10-34-WRF-TLS
PROTON_PATH=""

# (Linux only) Launch the game under gamescope's headless backend ('gamescope
# --backend headless') during the mapper step so no window appears on screen and
# no interactive desktop session is required. The GPU still renders offscreen;
# only the visible window is suppressed. Requires the 'gamescope' package.
# Ignored on Windows. Set to false to launch on the current DISPLAY (useful for
# debugging the launch visually).
HEADLESS="True"
